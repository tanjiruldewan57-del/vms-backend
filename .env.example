# ==============================================================================
# VMS Backend - Environment Variables Template
# Copy this file to .env and configure secrets locally. NEVER commit .env to git!
# ==============================================================================

# Active Spring Profile (e.g. local, prod)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# SQL Database Connectivity Foundation
# ------------------------------------------------------------------------------
# Example PostgreSQL:
DB_URL=jdbc:postgresql://127.0.0.1:5432/vms_db
DB_USERNAME=vms_user
DB_PASSWORD=REDACTED_DATABASE_PASSWORD
DB_DRIVER=org.postgresql.Driver

# Example MySQL:
# DB_URL=jdbc:mysql://127.0.0.1:3306/vms_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=vms_user
# DB_PASSWORD=REDACTED_DATABASE_PASSWORD
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# Connection Pool Tuning (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# JPA Schema Management (validate, update, create-drop, none)
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
